<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          manifestVersion="1.0">

  <!-- ── Identity ──────────────────────────────────────── -->
  <assemblyIdentity
    version    = "1.0.0.0"
    processorArchitecture = "*"
    name       = "ArchiveFldr.Settings"
    type       = "win32"
  />

  <description>
    ArchiveFldr Settings — preferences for the ArchiveFldr shell
    extension. A separate program so the shell extension does not
    have to carry a settings window into every process that loads
    it, and so it can ask for the rights its machine-wide settings
    need without the shell asking too.
  </description>

  <!-- ── Common Controls 6.0 (visual styles) ───────────── -->
  <!-- Without this the tab strip and the list views fall back to the
       Windows 95 look, and the dialog font comes out wrong. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type                = "win32"
        name                = "Microsoft.Windows.Common-Controls"
        version             = "6.0.0.0"
        processorArchitecture = "*"
        publicKeyToken      = "6595b64144ccf1df"
        language            = "*"
      />
    </dependentAssembly>
  </dependency>

  <!-- ── UAC ───────────────────────────────────────────── -->
  <!-- There is deliberately no trustInfo here. The level is
       requireAdministrator, set by UACExecutionLevel in
       ArchiveFldrSetting.vcxproj, and mt.exe merges this file with the
       snippet MSBuild generates from that property. Two snippets that
       disagree about "level" are a hard error, c1010001, which surfaces
       as LNK1327 at link time, so the value lives in exactly one place.

       Why administrator: every setting this program owns is
       machine-wide. Preferences live in HKLM\SOFTWARE\ArchiveFldr and
       the Install / Uninstall buttons register a shell extension for
       every account. Asking once at launch is honest; the alternative
       is a window that opens happily and then fails on save. -->

  <!-- ── Windows 10+ compatibility ────────────────────── -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- ── DPI awareness ─────────────────────────────────── -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware
        xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
        true/PM
      </dpiAware>
      <dpiAwareness
        xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2, PerMonitor
      </dpiAwareness>
      <longPathAware
        xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        true
      </longPathAware>
    </windowsSettings>
  </application>

</assembly>
