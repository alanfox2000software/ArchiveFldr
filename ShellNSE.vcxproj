      <DisableSpecificWarnings>
        4091;4229;4471;4819;4251;%(DisableSpecificWarnings)
      </DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ModuleDefinitionFile>src\ShellExt.def</ModuleDefinitionFile>
      <AdditionalDependencies>
        shlwapi.lib;
        shell32.lib;
        ole32.lib;
        oleaut32.lib;
        uuid.lib;
        comctl32.lib;
        user32.lib;
        gdi32.lib;
        advapi32.lib;
        uxtheme.lib;
        dwmapi.lib;
        comdlg32.lib;
        %(AdditionalDependencies)
