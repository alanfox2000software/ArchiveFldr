  <!-- NOTE: both platforms now share one OutDir (bin\$(Configuration)\) so
       that ShellNSE.32.dll and ShellNSE.64.dll land side by side, alongside
       a shared thirdparty\ tree (see PostBuildEvent below) — this is
       what lets ShellNSE locate its bitness-matched engine DLLs relative
       to its own module path at runtime (see src\ThirdParty.h). IntDir stays per-arch so the two
       builds' object files never collide. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\</IntDir>
    <TargetName>ShellNSE.32</TargetName>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\</IntDir>
