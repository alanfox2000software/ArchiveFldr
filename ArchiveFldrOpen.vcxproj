  ════════════════════════════════════════════════════ -->
  <!-- Both platforms share one OutDir (bin\$(Configuration)\) so that
       ArchiveFldr.32.dll and ArchiveFldr.64.dll land side by side,
       alongside a shared thirdparty\ tree (see PostBuildEvent below).
       That is what lets ArchiveFldr find its bitness-matched engine
       DLLs relative to its own module path at runtime (see
       src\ThirdParty.h).

       IntDir, by contrast, is per architecture AND per project. Both
       projects compile res\resource.rc, so a shared IntDir had them
       writing the same resource.res, and MSBuild's file trackers
       (CL.*.tlog, link.*.tlog, mt.*.tlog) collided in the same place:
       that is warning MSB8028, and it makes clean and incremental
       builds unreliable. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x64\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x64\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <!-- ═══════════════════════════════════════════════════
       Shared Preprocessor Definitions (property sheet style)
       These are the CRITICAL WRL/WinRT conflict fixes:
         __WRL_NO_DEFAULT_LIB__  — stops WRL auto-linking WinRT
         __WRL_CLASSIC_COM__     — keeps WRL in classic COM mode
         RO_NO_TEMPLATE_NAME     — stops IInspectable becoming template
         _HIDE_GLOBAL_ASYNC_STATUS — suppresses WinRT async headers
  ════════════════════════════════════════════════════ -->
  <PropertyGroup Label="SharedDefines">
    <WrlFixDefines>
      __WRL_NO_DEFAULT_LIB__;
      __WRL_CLASSIC_COM__;
      RO_NO_TEMPLATE_NAME;
      _HIDE_GLOBAL_ASYNC_STATUS;
    </WrlFixDefines>
    <CommonDefines>
      UNICODE;
      _UNICODE;
      _WINDOWS;
      $(ArchiveFldrTargetDefines)
      WIN32_LEAN_AND_MEAN;
      NOMINMAX;
      STRICT;
    </CommonDefines>
    <!-- /utf-8        = source + execution charset both UTF-8 (fixes C4819)
         /wd4091       = suppress 'typedef ignored' in SDK headers
         /wd4229       = suppress 'anachronism: modifiers on data'
         /wd4471       = suppress unscoped enum forward decl warning
         /wd4819       = suppress code-page warning (redundant with /utf-8)
         /wd4251       = suppress dll-interface warning
         /Zc:__cplusplus = make __cplusplus report correct value    -->
    <CommonExtraOptions>
      /utf-8
      /wd4091
      /wd4229
      /wd4471
      /wd4819
      /wd4251
      /Zc:__cplusplus
    </CommonExtraOptions>
  </PropertyGroup>
  <!-- ═══════════════════════════════════════════════════
       Item Definition Groups — Compiler + Linker
       One per configuration (4 total)
  ════════════════════════════════════════════════════ -->
  <!-- ──────────────────────────────────────────────────
       DEBUG | Win32
  ────────────────────────────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>Disabled</Optimization>
      <SDLCheck>true</SDLCheck>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- C++20 — do NOT use stdcpp23, it pulls <expected> & WinRT -->
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>
        src;res;%(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;
        _DEBUG;
        $(CommonDefines)
        $(WrlFixDefines)
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <!-- UTF-8 + SDK warning suppression -->
      <AdditionalOptions>
        $(CommonExtraOptions) %(AdditionalOptions)
      </AdditionalOptions>
      <DisableSpecificWarnings>
        4091;4229;4471;4819;4251;%(DisableSpecificWarnings)
      </DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Lowest Windows the loader will accept this binary on: 5.01 is
           Windows XP (x86) and 5.02 is XP x64 / Server 2003, which is the
           floor for any 64-bit build. Without this the linker stamps a
           6.00+ subsystem version and XP refuses the DLL outright. -->
      <MinimumRequiredVersion Condition="'$(Platform)'=='Win32'">5.01</MinimumRequiredVersion>
      <MinimumRequiredVersion Condition="'$(Platform)'=='x64'">5.02</MinimumRequiredVersion>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>
        shlwapi.lib;
        shell32.lib;
        ole32.lib;
        oleaut32.lib;
        uuid.lib;
        comctl32.lib;
        user32.lib;
        gdi32.lib;
        advapi32.lib;
        uxtheme.lib;
        comdlg32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <!-- Do NOT link runtimeobject.lib (WinRT) -->
      <!-- Runs as the user, every time an archive is opened.
           Elevating here would put a UAC prompt in front of a
           double-click. -->
    </Link>
    <PostBuildEvent>
      <Command>echo [ArchiveFldrOpen] Built Debug x86: $(TargetFileName)</Command>
      <Message>Building open helper (Debug x86)...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
