  <!-- ═══════════════════════════════════════════════════
       Source Files

       Small on purpose: this sits in front of every archive open, so
       its whole job is to start and hand off.

       BrowseTo.cpp is shared with the shell extension rather than
       copied. It is the code behind the context menu's "Open with
       ArchiveFldr", it already knows the three ways this goes wrong,
       and a second implementation of it is exactly how the open verb
       ended up opening nothing and then opening three windows.
  ════════════════════════════════════════════════════ -->
  <ItemGroup>
    <ClCompile Include="src\OpenMain.cpp" />
    <ClCompile Include="src\BrowseTo.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\BrowseTo.h" />
    <ClInclude Include="src\stdafx.h" />
  </ItemGroup>
  <!-- ═══════════════════════════════════════════════════
       Resource Files
  ════════════════════════════════════════════════════ -->
  <ItemGroup>
    <ResourceCompile Include="res\open.rc">
      <AdditionalOptions>/n %(AdditionalOptions)</AdditionalOptions>
    </ResourceCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- ═══════════════════════════════════════════════════
       Win32 companion

       Same arrangement as ArchiveFldr.vcxproj, and now necessary
       rather than merely tidy. Each platform builds into its own
       folder, so an x64 build that produced no 32-bit helper would
       leave bin\$(Configuration)\win32 with a DLL and nothing to open
       with — and the 32-bit half of Install would then rewrite the
       shared open command to point at Explorer, undoing the 64-bit
       half's work on a key both of them share.

       Recursion stops by construction: the nested build is Win32 and
       this only runs for x64. Set ArchiveFldrBuildWin32Companion=false
       to turn it off.
  ═══════════════════════════════════════════════════ -->
  <PropertyGroup>
    <ArchiveFldrBuildWin32Companion Condition="'$(ArchiveFldrBuildWin32Companion)' == ''">true</ArchiveFldrBuildWin32Companion>
    <ArchiveFldrWin32Companion Condition="'$(Platform)' == 'x64' AND '$(ArchiveFldrBuildWin32Companion)' == 'true'">true</ArchiveFldrWin32Companion>
  </PropertyGroup>

  <Target Name="ArchiveFldrOpenBuildWin32"
          AfterTargets="Build"
          Condition="'$(ArchiveFldrWin32Companion)' == 'true'">
    <Message Importance="high"
             Text="[ArchiveFldrOpen] $(Configuration)|x64 also builds the 32-bit helper..." />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=Win32" />
  </Target>

  <Target Name="ArchiveFldrOpenCleanWin32"
          AfterTargets="Clean"
          Condition="'$(ArchiveFldrWin32Companion)' == 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Clean"
             Properties="Configuration=$(Configuration);Platform=Win32" />
  </Target>
</Project>
