  <!-- One output folder per configuration AND platform:
       bin\Debug\win32, bin\Debug\x64, bin\Release\win32,
       bin\Release\x64.

       The two bitnesses used to share bin\$(Configuration)\ so that
       ArchiveFldr.32.dll and ArchiveFldr.64.dll landed side by side.
       That had one real virtue — the settings program could find its
       opposite-bitness DLL by looking next to itself — and one real
       vice: ArchiveFldrOpen.exe carries the same name in both
       platforms, so whichever built last silently overwrote the
       other. Separate folders end the overwrite, and CPageInstall
       learned to look in the sibling folder to keep the virtue.

       thirdparty\ can still be a single shared tree. Put it in
       bin\$(Configuration)\, the parent of these two, and both
       bitnesses will find it: ThirdParty::ProbePaths looks one level
       up as well as beside the module.

       IntDir is per architecture AND per project. Both projects
       compile res\resource.rc, so a shared IntDir had them writing the
       same resource.res, and MSBuild's file trackers (CL.*.tlog,
       link.*.tlog, mt.*.tlog) collided in the same place: that is
       warning MSB8028, and it makes clean and incremental builds
       unreliable. -->
  <!-- ONE TargetName for both platforms. Not an oversight, and not to
       be "fixed" into ArchiveFldrOpen.32 / .64 the way the DLL and the
       settings program are named.

       Windows keys an entry in "Open with" and "pick a default app" on
       the BASE NAME of the executable in the open command, and merges
       handlers that share one. Two names would be two applications, so
       the picker would list two identical "ArchiveFldr" rows. Owning a
       single name is the entire reason this program exists.

       It does not have to match the bitness of whatever called it.
       HKLM\SOFTWARE\Classes is *shared* between the 32- and 64-bit
       registry views — only CLSID, Interface, TypeLib and a few media
       keys under it are redirected — so a 32-bit caller reads exactly
       the same open command as a 64-bit one, and a process of either
       bitness can start a program of the other. Whichever build lands
       here last is the one that runs, and on x64 Windows both work.

       The single case where it does matter: a 64-bit build of this
       program will not run on 32-bit Windows. That is also the only
       case where it cannot arise, because a 32-bit Windows is given
       the Win32 build of everything. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\win32\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\win32\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x86\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\x64\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x64\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)bin\$(Configuration)\x64\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\x64\$(ProjectName)\</IntDir>
    <TargetName>ArchiveFldrOpen</TargetName>
    <TargetExt>.exe</TargetExt>
  </PropertyGroup>
  <!-- ═══════════════════════════════════════════════════
       Shared Preprocessor Definitions (property sheet style)
       These are the CRITICAL WRL/WinRT conflict fixes:
         __WRL_NO_DEFAULT_LIB__  — stops WRL auto-linking WinRT
         __WRL_CLASSIC_COM__     — keeps WRL in classic COM mode
         RO_NO_TEMPLATE_NAME     — stops IInspectable becoming template
         _HIDE_GLOBAL_ASYNC_STATUS — suppresses WinRT async headers
  ════════════════════════════════════════════════════ -->
  <PropertyGroup Label="SharedDefines">
    <WrlFixDefines>
      __WRL_NO_DEFAULT_LIB__;
      __WRL_CLASSIC_COM__;
      RO_NO_TEMPLATE_NAME;
      _HIDE_GLOBAL_ASYNC_STATUS;
    </WrlFixDefines>
    <CommonDefines>
      UNICODE;
      _UNICODE;
      _WINDOWS;
      $(ArchiveFldrTargetDefines)
      WIN32_LEAN_AND_MEAN;
      NOMINMAX;
      STRICT;
    </CommonDefines>
    <!-- /utf-8        = source + execution charset both UTF-8 (fixes C4819)
         /wd4091       = suppress 'typedef ignored' in SDK headers
         /wd4229       = suppress 'anachronism: modifiers on data'
         /wd4471       = suppress unscoped enum forward decl warning
         /wd4819       = suppress code-page warning (redundant with /utf-8)
         /wd4251       = suppress dll-interface warning
         /Zc:__cplusplus = make __cplusplus report correct value    -->
    <CommonExtraOptions>
      /utf-8
      /wd4091
      /wd4229
      /wd4471
      /wd4819
      /wd4251
      /Zc:__cplusplus
    </CommonExtraOptions>
  </PropertyGroup>
