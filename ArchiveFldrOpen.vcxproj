    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <!-- ═══════════════════════════════════════════════════
       Global Properties
  ════════════════════════════════════════════════════ -->
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567892}</ProjectGuid>
    <RootNamespace>ArchiveFldrOpen</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <!-- The XP toolset brings its own (Windows 7.1A) SDK, so only pin the
         modern SDK version when we are not building for XP. -->
    <WindowsTargetPlatformVersion Condition="!$(ArchiveFldrToolset.EndsWith('_xp'))">10.0.28000.0</WindowsTargetPlatformVersion>
    <!-- Toolset override. Defaults to v145 (VS2026) for a normal build:
           msbuild ArchiveFldr.sln /p:Configuration=Release /p:Platform=x64
         To produce a binary whose CRT actually runs on Windows XP, build
         with the XP-capable toolset instead (needs the VS2017 build tools
         and the "Windows XP support for C++" component installed):
           msbuild ArchiveFldr.sln /p:ArchiveFldrToolset=v141_xp
         See BUILD-XP.md. -->
    <ArchiveFldrToolset Condition="'$(ArchiveFldrToolset)'==''">v145</ArchiveFldrToolset>
    <!-- Targeting macros follow the toolset. They have to: with
         _WIN32_WINNT at 0x0A00 the STL compiles std::mutex down to SRW
         locks, which XP's kernel32 does not export, and the extension
         would not load no matter which toolset built it. ARCHIVEFLDR_XP also
         compiles out the thumbnail provider and preview handler, neither
         of which exists before Vista. -->
    <ArchiveFldrTargetDefines Condition="$(ArchiveFldrToolset.EndsWith('_xp'))">ARCHIVEFLDR_XP;_WIN32_WINNT=0x0501;WINVER=0x0501;NTDDI_VERSION=0x05010300;</ArchiveFldrTargetDefines>
    <ArchiveFldrTargetDefines Condition="!$(ArchiveFldrToolset.EndsWith('_xp'))">_WIN32_WINNT=0x0A00;WINVER=0x0A00;NTDDI_VERSION=0x0A000006;</ArchiveFldrTargetDefines>
    <ProjectName>ArchiveFldrOpen</ProjectName>
    <VCProjectVersion>18.0</VCProjectVersion>
    <!-- Force UTF-8 for all source files project-wide -->
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
