<?xml version="1.0" encoding="utf-8"?>
<!--
  ShellNSE.vcxproj.user
  Developer machine settings — NOT committed to source control.
  Configures F5 / Ctrl+F5 to:
    1. Register the DLL with regsvr32
    2. Launch Windows Explorer for live testing
-->
<Project ToolsVersion="18.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ═══ Debug | Win32 ═══════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <!-- Launch Explorer so the extension is loaded immediately -->
    <LocalDebuggerCommand>$(WINDIR)\explorer.exe</LocalDebuggerCommand>
    <!-- Open the project's test archive folder in Explorer -->
    <LocalDebuggerCommandArguments>$(SolutionDir)TestArchives\</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <!-- Pre-debug: re-register the DLL
         (Post-build event already does this; keep as safety net) -->
    <PreDebugEvent>
      <Command>regsvr32 /s "$(TargetPath)"</Command>
    </PreDebugEvent>
  </PropertyGroup>
  <!-- ═══ Debug | x64 ════════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LocalDebuggerCommand>$(WINDIR)\explorer.exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>$(SolutionDir)TestArchives\</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <PreDebugEvent>
      <Command>regsvr32 /s "$(TargetPath)"</Command>
    </PreDebugEvent>
    <LocalDebuggerCommandArgumentsHistory>D:\Downloads\ShellNSE\TestArchives\|</LocalDebuggerCommandArgumentsHistory>
  </PropertyGroup>
  <!-- ═══ Release | Win32 ════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <LocalDebuggerCommand>$(WINDIR)\SysWOW64\regsvr32.exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>"$(TargetPath)"</LocalDebuggerCommandArguments>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <!-- ═══ Release | x64 ══════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LocalDebuggerCommand>$(WINDIR)\System32\regsvr32.exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>"$(TargetPath)"</LocalDebuggerCommandArguments>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
</Project>