      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- C++20 — do NOT use stdcpp23, it pulls <expected> & WinRT -->
      <LanguageStandard>$(ArchiveFldrLangStandard)</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>
        src;res;%(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;
        _DEBUG;
        $(CommonDefines)
        $(WrlFixDefines)
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <!-- UTF-8 + SDK warning suppression -->
      <AdditionalOptions>
        $(CommonExtraOptions) %(AdditionalOptions)
      </AdditionalOptions>
      <DisableSpecificWarnings>
        4091;4229;4471;4819;4251;%(DisableSpecificWarnings)
      </DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Lowest Windows the loader will accept this binary on: 5.01 is
           Windows XP (x86) and 5.02 is XP x64 / Server 2003, which is the
           floor for any 64-bit build. Without this the linker stamps a
           6.00+ subsystem version and XP refuses the DLL outright. -->
      <MinimumRequiredVersion Condition="'$(Platform)'=='Win32'">5.01</MinimumRequiredVersion>
      <MinimumRequiredVersion Condition="'$(Platform)'=='x64'">5.02</MinimumRequiredVersion>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ModuleDefinitionFile>src\ArchiveFldr.def</ModuleDefinitionFile>
      <!-- Nothing links against a shell extension, so the import
           library and its .exp are build residue. Keep them in IntDir
           rather than beside the DLL or loose in the source tree. -->
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <AdditionalDependencies>
        shlwapi.lib;
        shell32.lib;
        ole32.lib;
        oleaut32.lib;
        uuid.lib;
        comctl32.lib;
        user32.lib;
        gdi32.lib;
        advapi32.lib;
        uxtheme.lib;
        comdlg32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <!-- Do NOT link runtimeobject.lib (WinRT) -->
    </Link>
    <PostBuildEvent>
      <Command>if exist "$(ProjectDir)thirdparty\" xcopy /y /i /e /s "$(ProjectDir)thirdparty\*.dll" "$(OutDir)thirdparty\" &gt;nul 2&gt;nul
if exist "$(ProjectDir)Lang\" xcopy /y /i "$(ProjectDir)Lang\*.txt" "$(OutDir)Lang\" &gt;nul 2&gt;nul
set "RS=%SystemRoot%\SysWOW64\regsvr32.exe"
if not exist "%RS%" set "RS=%SystemRoot%\System32\regsvr32.exe"
"%RS%" /s "$(TargetPath)" &amp;&amp; echo [ArchiveFldr] Registered Debug x86: $(TargetFileName) || echo [ArchiveFldr] Built Debug x86: $(TargetFileName) - NOT registered, run Visual Studio as administrator
exit /b 0</Command>
      <Message>Registering Shell Extension (Debug x86)...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
