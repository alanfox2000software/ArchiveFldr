// Resources for ArchiveFldrOpen.exe.
//
// Deliberately tiny and separate from resource.rc. This program needs
// exactly two things from a resource script: the ArchiveFldr icon, so
// the shell has something to draw for it before any registry metadata
// is consulted, and a version block that says what it is.
//
// The icon is id 1 here for the same reason it is id 1 everywhere else
// in the project — the shell takes an executable's first icon when it
// is given no index, and "first" means lowest id, not first listed.

#include <windows.h>

1 ICON "resource.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ArchiveFldr Project"
            VALUE "FileDescription",  "ArchiveFldr"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ArchiveFldrOpen"
            VALUE "OriginalFilename", "ArchiveFldrOpen.exe"
            VALUE "ProductName",      "ArchiveFldr Archive Shell Extension"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
